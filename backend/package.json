{
  "name": "slate-backend",
  "version": "2.0.0",
  "description": "Slate v2 backend — Bun + Elysia + bun:sqlite. The home-screen surface where your agent asks and answers.",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun run src/index.ts",
    "start": "bun run src/index.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "coverage": "bun test --coverage --coverage-reporter=lcov && node scripts/check-coverage.mjs 80"
  },
  "dependencies": {
    "@sinclair/typebox": "^0.34.52",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "elysia": "^1.4.18"
  },
  "devDependencies": {
    "@types/bun": "^1.3.5",
    "typescript": "^5.9.3"
  }
}
